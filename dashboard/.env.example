# Uses Supabase's new publishable key (sb_publishable_...), not the legacy
# anon JWT. Same low-privilege, browser-safe role as anon -- RLS still
# applies. Find it at Settings -> API Keys -> "Publishable and secret API
# keys" tab.
VITE_SUPABASE_URL=https://xxxxx.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
