# Copy to .env and fill in real values. Never commit .env.
#
# Uses Supabase's new secret key (sb_secret_...), not the legacy
# service_role JWT. Find it at Settings -> API Keys -> "Publishable and
# secret API keys" tab (create one there if you only see legacy keys).
# It carries BYPASSRLS like service_role did -- never ship it to the browser.
SUPABASE_URL=https://xxxxx.supabase.co
SUPABASE_SECRET_KEY=sb_secret_...
OPENAI_API_KEY=sk-...
OPENAI_RESPONSES_URL=https://api.openai.com/v1/responses
